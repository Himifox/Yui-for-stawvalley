<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>YuiToIssho</AssemblyName>
    <RootNamespace>YuiToIssho</RootNamespace>
    <Version>0.31.0</Version>
    <AssemblyVersion>0.31.0.0</AssemblyVersion>
    <FileVersion>0.31.0.0</FileVersion>
    <InformationalVersion>0.31.0</InformationalVersion>
    <EnableModDeploy>false</EnableModDeploy>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Pathoschild.Stardew.ModBuildConfig" Version="4.4.0" />
    <Reference Include="0Harmony">
      <HintPath>$(GamePath)\smapi-internal\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
